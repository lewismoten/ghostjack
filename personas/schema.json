{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghost Jack persona",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,23}$" },
    "voice": {
      "type": "string",
      "description": "A macOS voice from GET /api/voices; empty is the system voice"
    },
    "rate": { "type": "integer", "minimum": 90, "maximum": 220 },
    "level": { "type": "number", "minimum": 0.01, "maximum": 0.05 },
    "output": {
      "enum": ["camera", "mac"],
      "description": "Where speech comes out: the camera speaker or the Mac's own output"
    },
    "style": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,24}$",
      "description": "netrunner, plain, or your own word"
    },
    "wakeWords": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "pattern": "^[a-zA-Z]{3,30}$" }
    },
    "sayAs": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "maxLength": 40 },
          "to": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "glossary": {
      "type": "object",
      "maxProperties": 40,
      "description": "term: meaning overrides or additions to docs/glossary.md",
      "additionalProperties": { "type": "string", "maxLength": 200 }
    },
    "vocabulary": {
      "type": "array",
      "description": "words the transcriber should know (400 characters in all, with the global list)",
      "items": { "type": "string", "maxLength": 40 }
    },
    "greeting": { "type": "string", "maxLength": 200 },
    "signoff": { "type": "string", "maxLength": 200 },
    "tones": {
      "type": "object",
      "description": "start, done, interrupting, heard: true or false"
    }
  }
}
